# Turso (libSQL) — primary database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob — image/file uploads from the admin CMS
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Admin auth (single-account, signed-cookie session via iron-session)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Contact form email delivery
EMAIL_USER=
EMAIL_PASS=

# Paystack (Studio Plugin Store checkout — real mode, Standard/redirect flow)
PAYSTACK_SECRET_KEY=

# Optional: a GitHub token (no scopes needed) lifts the 60-requests-an-hour limit on the
# ClipPro release lookups (lib/clippro.ts). Without it, releases are cached for 10 minutes.
GITHUB_TOKEN=
